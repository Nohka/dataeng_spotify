# Copy to .env and adjust if you need to:
#
#     cp .env.example .env
#
# Every value is optional: compose.yml falls back to these same defaults when .env is absent.
# .env is gitignored -- never commit real credentials.

# --- Kaggle (optional) ---
# The dataset is public, so the DAG first tries to download it without logging in.
# If the download fails with 401/403, add your own credentials here:
# Kaggle -> Settings -> API -> "Create New Token" downloads kaggle.json with these two values.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Pipeline parameters (defaults for the DAG; can be changed per run in the Airflow UI) ---
# First chart date to load and analyse
PIPELINE_START_DATE=2025-01-01
# Kaggle dataset version: empty = latest, e.g. 143 to pin a version
KAGGLE_DATASET_VERSION=
# DuckDB memory limit: keep below the memory Docker is allowed to use
DUCKDB_MEMORY_LIMIT=4GB

# --- Image versions ---
POSTGRES_VERSION=16.4
AIRFLOW_VERSION=2.8.1

# --- Airflow metadata database ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Raw database (the Kaggle tables the DAG loads; RAW_DB_PORT is the laptop port for DBeaver) ---
RAW_DB_USER=raw_user
RAW_DB_PASSWORD=raw_pass
RAW_DB_NAME=spotify_raw
RAW_DB_PORT=5433

# --- Airflow web UI ---
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
