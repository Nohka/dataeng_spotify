{
  "schema": "music_report_v1",
  "version": "1",
  "status": "proposed; no real-source profiling or PostgreSQL execution claimed",
  "tables": [
    {
      "table": "dim_date",
      "grain": "One calendar date",
      "history_policy": "Static",
      "columns": [
        {
          "name": "date_key",
          "postgresql_type": "INTEGER",
          "description": "Warehouse date key in YYYYMMDD form.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false
        },
        {
          "name": "full_date",
          "postgresql_type": "DATE",
          "description": "UTC chart calendar date.",
          "nullable": false,
          "primary_key_component": false,
          "unique": true
        },
        {
          "name": "iso_week_start_date",
          "postgresql_type": "DATE",
          "description": "Monday beginning the reporting week.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "dim_market",
      "grain": "One chart market",
      "history_policy": "Static for v1; freeze documented European panel",
      "columns": [
        {
          "name": "market_key",
          "postgresql_type": "SMALLINT",
          "description": "Warehouse market ID.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false
        },
        {
          "name": "market_code",
          "postgresql_type": "VARCHAR(16)",
          "description": "Normalised source market code, such as EE or GLOBAL.",
          "nullable": false,
          "primary_key_component": false,
          "unique": true
        },
        {
          "name": "market_name",
          "postgresql_type": "TEXT",
          "description": "Market display name.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "is_europe",
          "postgresql_type": "BOOLEAN",
          "description": "Membership in the fixed European analysis panel; FALSE for GLOBAL.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "dim_track",
      "grain": "One source track identity",
      "history_policy": "Type 1; current supplied metadata",
      "columns": [
        {
          "name": "track_key",
          "postgresql_type": "BIGINT",
          "description": "Warehouse track ID.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false
        },
        {
          "name": "spotify_track_uri",
          "postgresql_type": "TEXT",
          "description": "Source track identifier; do not join by title.",
          "nullable": false,
          "primary_key_component": false,
          "unique": true
        },
        {
          "name": "track_name",
          "postgresql_type": "TEXT",
          "description": "Track display title.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "record_label_current",
          "postgresql_type": "TEXT",
          "description": "Latest supplied label, not historical ownership.",
          "nullable": true,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "dim_artist",
      "grain": "One Spotify artist identity",
      "history_policy": "Type 1; current name and accepted match",
      "columns": [
        {
          "name": "artist_key",
          "postgresql_type": "BIGINT",
          "description": "Warehouse artist ID.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false
        },
        {
          "name": "spotify_artist_uri",
          "postgresql_type": "TEXT",
          "description": "Source artist identifier; do not join by name.",
          "nullable": false,
          "primary_key_component": false,
          "unique": true
        },
        {
          "name": "artist_name",
          "postgresql_type": "TEXT",
          "description": "Current artist display name.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "musicbrainz_id",
          "postgresql_type": "UUID",
          "description": "Accepted MusicBrainz artist match.",
          "nullable": true,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "bridge_track_artist",
      "grain": "One uniquely credited artist per track",
      "history_policy": "Current relationship; retain raw credit lists",
      "columns": [
        {
          "name": "track_key",
          "postgresql_type": "BIGINT",
          "description": "Track participating in the credit relationship.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_track.track_key"
        },
        {
          "name": "artist_key",
          "postgresql_type": "BIGINT",
          "description": "Artist credited on the track.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_artist.artist_key"
        }
      ]
    },
    {
      "table": "artist_locality",
      "grain": "One current artist-market classification",
      "history_policy": "Type 1; retain raw review evidence separately",
      "columns": [
        {
          "name": "artist_key",
          "postgresql_type": "BIGINT",
          "description": "Reviewed artist.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_artist.artist_key"
        },
        {
          "name": "market_key",
          "postgresql_type": "SMALLINT",
          "description": "Market against which locality is evaluated.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_market.market_key"
        },
        {
          "name": "local_status",
          "postgresql_type": "VARCHAR(12)",
          "description": "local, not_local or unknown.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "evidence_url",
          "postgresql_type": "TEXT",
          "description": "Evidence reference; required for known status.",
          "nullable": true,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "reviewed_at",
          "postgresql_type": "TIMESTAMPTZ",
          "description": "Review timestamp; required for known status.",
          "nullable": true,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "rule_version",
          "postgresql_type": "TEXT",
          "description": "Documented classification rule; v1 for supplied views.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "fact_track_chart_daily",
      "grain": "One observed track appearance per UTC chart date and market",
      "history_policy": "Daily measurement fact",
      "columns": [
        {
          "name": "date_key",
          "postgresql_type": "INTEGER",
          "description": "UTC chart date.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_date.date_key"
        },
        {
          "name": "market_key",
          "postgresql_type": "SMALLINT",
          "description": "Chart market.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_market.market_key"
        },
        {
          "name": "track_key",
          "postgresql_type": "BIGINT",
          "description": "Charting track.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_track.track_key"
        },
        {
          "name": "chart_rank",
          "postgresql_type": "SMALLINT",
          "description": "Daily chart position, from 1 to 200; non-additive.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "streams",
          "postgresql_type": "BIGINT",
          "description": "Reported chart-eligible streams, not unique listeners; >= 0 when known.",
          "nullable": true,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "loaded_at",
          "postgresql_type": "TIMESTAMPTZ",
          "description": "Warehouse row load timestamp.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        }
      ]
    },
    {
      "table": "ops_chart_load_daily",
      "grain": "One expected daily chart load per market and date",
      "history_policy": "Current load status; attempt history in raw manifests",
      "columns": [
        {
          "name": "date_key",
          "postgresql_type": "INTEGER",
          "description": "Expected chart date.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_date.date_key"
        },
        {
          "name": "market_key",
          "postgresql_type": "SMALLINT",
          "description": "Expected chart market.",
          "nullable": false,
          "primary_key_component": true,
          "unique": false,
          "references": "dim_market.market_key"
        },
        {
          "name": "load_status",
          "postgresql_type": "VARCHAR(12)",
          "description": "complete, partial, missing, failed or unknown.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        },
        {
          "name": "loaded_at",
          "postgresql_type": "TIMESTAMPTZ",
          "description": "Load-status update timestamp.",
          "nullable": false,
          "primary_key_component": false,
          "unique": false
        }
      ]
    }
  ]
}
